a:3:{s:5:"value";a:2:{i:0;a:11:{s:2:"id";i:1;s:5:"judul";s:45:"Tim Fisika Raih Pendanaan Riset Nasional 2026";s:4:"slug";s:45:"tim-fisika-raih-pendanaan-riset-nasional-2026";s:8:"kategori";s:8:"Prestasi";s:3:"isi";s:209:"<p>Tim peneliti Program Studi Fisika berhasil memperoleh pendanaan riset nasional untuk kajian material maju berbasis nanoteknologi. Penelitian ini akan berlangsung selama dua tahun bersama mitra industri.</p>";s:6:"gambar";s:93:"https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=60";s:7:"penulis";s:5:"Humas";s:7:"tanggal";s:10:"2026-09-14";s:5:"views";i:128;s:6:"status";i:1;s:6:"dibuat";s:19:"2026-10-22 19:04:27";}i:1;a:11:{s:2:"id";i:3;s:5:"judul";s:50:"Kuliah Tamu: Fisika Medis di Era Kecerdasan Buatan";s:4:"slug";s:49:"kuliah-tamu-fisika-medis-di-era-kecerdasan-buatan";s:8:"kategori";s:8:"Akademik";s:3:"isi";s:142:"<p>Praktisi fisika medis dari rumah sakit mitra memberikan kuliah tamu mengenai pemanfaatan kecerdasan buatan dalam pencitraan diagnostik.</p>";s:6:"gambar";s:93:"https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=60";s:7:"penulis";s:5:"Humas";s:7:"tanggal";s:10:"2026-07-30";s:5:"views";i:74;s:6:"status";i:1;s:6:"dibuat";s:19:"2026-10-22 19:04:27";}}s:7:"expires";i:1792730831;s:7:"created";i:1792729031;}